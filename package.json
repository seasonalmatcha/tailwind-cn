{
  "name": "tailwind-cn",
  "version": "1.0.2",
  "description": "Wrapper to combine tailwind classes",
  "private": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "scripts": {
    "build": "tsdown src/index.ts --format cjs,esm --dts",
    "ci": "pnpm run lint && pnpm run test && pnpm run build",
    "dev": "vitest",
    "lint": "tsc",
    "release": "pnpm run lint && pnpm run test && pnpm run build && changeset publish",
    "test": "vitest run"
  },
  "keywords": ["tailwindcss", "clsx", "tailwind-merge", "css", "classnames"],
  "author": "Alan H (me@alanh.dev)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/seasonalmatcha/tailwind-cn"
  },
  "bugs": {
    "url": "https://github.com/seasonalmatcha/tailwind-cn/issues"
  },
  "homepage": "https://github.com/seasonalmatcha/tailwind-cn",
  "devDependencies": {
    "@changesets/cli": "^2.26.2",
    "@types/node": "^25.0.3",
    "clsx": "^2.0.0",
    "tailwind-merge": "^3.4.0",
    "tsdown": "^0.18.2",
    "typescript": "^5.1.6",
    "vitest": "^4.0.16"
  }
}
